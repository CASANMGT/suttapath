      "uid": "an5.177:0.1",
      "text": "Numbered Discourses 5.177"
    },
    {
      "uid": "an5.177:0.2",
      "text": "18. A Lay Follower"
    },
    {
      "uid": "an5.177:0.3",
      "text": "Trades"
    },
    {
      "uid": "an5.177:1.1",
      "text": "\"Mendicants, a lay follower should not engage in these five trades."
    },
    {
      "uid": "an5.177:1.2",
      "text": "What five?"
    },
    {
      "uid": "an5.177:1.3",
      "text": "Trade in weapons, living creatures, meat, intoxicants, and poisons."
    },
    {
      "uid": "an5.177:1.4",
      "text": "A lay follower should not engage in these five trades.\""
    },
    {
      "uid": "an5.177:1.5",
      "text": ""
    }
  ]
}
